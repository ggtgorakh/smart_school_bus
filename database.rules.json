        "conductorPhone": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Admin'", ".validate": "newData.val() == null || newData.isString()" },
        "routeId": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Admin'", ".validate": "newData.val() == null || newData.isString()" },
        "routeName": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Admin'", ".validate": "newData.isString()" }
