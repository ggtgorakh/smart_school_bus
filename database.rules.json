          "boardedAt": { ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (root.child('users').child(auth.uid).child('role').val() === 'Driver' && root.child('users').child(auth.uid).child('busId').val() === $busId) || (root.child('users').child(auth.uid).child('role').val() === 'Conductor' && root.child('users').child(auth.uid).child('busId').val() === $busId))" },
          "stopName": { ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (root.child('users').child(auth.uid).child('role').val() === 'Driver' && root.child('users').child(auth.uid).child('busId').val() === $busId) || (root.child('users').child(auth.uid).child('role').val() === 'Conductor' && root.child('users').child(auth.uid).child('busId').val() === $busId))" },
          "homeAddress": { ".write": "auth != null && data.child('parentUid').val() === auth.uid", ".validate": "newData.val() == null || newData.isString()" },
          "pickupStop": { ".write": "auth != null && data.child('parentUid').val() === auth.uid", ".validate": "newData.val() == null || newData.isString()" },
          "dropOffStop": { ".write": "auth != null && data.child('parentUid').val() === auth.uid", ".validate": "newData.val() == null || newData.isString()" },
          "emergencyContact": { ".write": "auth != null && data.child('parentUid').val() === auth.uid", ".validate": "newData.val() == null || newData.isString()" },
          "authorizedPickupPerson": { ".write": "auth != null && data.child('parentUid').val() === auth.uid", ".validate": "newData.val() == null || newData.isString()" },
          "transportationInstructions": { ".write": "auth != null && data.child('parentUid').val() === auth.uid", ".validate": "newData.val() == null || newData.isString()" }
        }
      }
    },

    "studentAbsences": {
      "$busId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (root.child('users').child(auth.uid).child('role').val() === 'Driver' && root.child('users').child(auth.uid).child('busId').val() === $busId) || (root.child('users').child(auth.uid).child('role').val() === 'Conductor' && root.child('users').child(auth.uid).child('busId').val() === $busId))",
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || (root.child('users').child(auth.uid).child('role').val() === 'Driver' && root.child('users').child(auth.uid).child('busId').val() === $busId) || (root.child('users').child(auth.uid).child('role').val() === 'Conductor' && root.child('users').child(auth.uid).child('busId').val() === $busId) || root.child('studentRosters').child($busId).child($studentId).child('parentUid').val() === auth.uid)",
          "$dateKey": {
