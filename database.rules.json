        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || data.child('actorUid').val() === auth.uid)",
        ".write": "auth != null && (!data.exists() ? (newData.child('actorUid').val() === auth.uid && (root.child('users').child(auth.uid).child('role').val() === 'Driver' || root.child('users').child(auth.uid).child('role').val() === 'Conductor' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Parent')) : (root.child('users').child(auth.uid).child('role').val() === 'Admin' || data.child('actorUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['eventId', 'actorUid', 'actorRole', 'alertType', 'status', 'timestamp']) && newData.child('eventId').val() === $eventId && newData.child('actorUid').isString() && newData.child('actorRole').val().matches(/^(Admin|Driver|Conductor|Parent)$/) && newData.child('alertType').isString() && newData.child('status').val().matches(/^(active|acknowledged|resolved|cancelled)$/) && newData.child('timestamp').isNumber() && (!newData.child('busId').exists() || newData.child('busId').isString()) && (!newData.child('tripId').exists() || newData.child('tripId').isString()) && (!newData.child('lat').exists() || (newData.child('lat').isNumber() && newData.child('lat').val() >= -90 && newData.child('lat').val() <= 90)) && (!newData.child('lng').exists() || (newData.child('lng').isNumber() && newData.child('lng').val() >= -180 && newData.child('lng').val() <= 180))"
      }
    },

    "adminIndex": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'Admin')",
        ".validate": "newData.val() === true || newData.val() == null"
      }
    },

    "broadcasts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Admin'",
      ".indexOn": ["timestamp"],
      "$broadcastId": {
        ".validate": "newData.hasChildren(['title', 'message', 'timestamp', 'senderUid']) && newData.child('title').isString() && newData.child('message').isString() && newData.child('timestamp').isNumber() && newData.child('senderUid').isString()"
      }
    }
  }
}